{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "build",
      "type": "process",
      "command": "dotnet",
      "args": ["build", "${workspaceFolder}/Distillate.sln", "-c", "Debug"],
      "problemMatcher": "$msCompile",
      "group": { "kind": "build", "isDefault": true }
    },
    {
      "label": "test",
      "type": "process",
      "command": "dotnet",
      "args": ["test", "${workspaceFolder}/Distillate.sln", "-c", "Release"],
      "problemMatcher": [],
      "group": { "kind": "test", "isDefault": true }
    },
    {
      "label": "format",
      "type": "process",
      "command": "dotnet",
      "args": ["format", "${workspaceFolder}/Distillate.sln"],
      "problemMatcher": []
    },
    {
      "label": "docker: build image",
      "type": "process",
      "command": "docker",
      "args": ["build", "-t", "distillate:local", "${workspaceFolder}"],
      "problemMatcher": []
    }
  ]
}

