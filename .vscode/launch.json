{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Distillate.Web (rest)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Distillate.Web/bin/Debug/net10.0/Distillate.Web.dll",
      "cwd": "${workspaceFolder}/src/Distillate.Web",
      "console": "internalConsole",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "MODE": "rest"
      }
    },
    {
      "name": "Distillate.Web (live)",
      "type": "coreclr",
      "request": "launch",
      "preLaunchTask": "build",
      "program": "${workspaceFolder}/src/Distillate.Web/bin/Debug/net10.0/Distillate.Web.dll",
      "cwd": "${workspaceFolder}/src/Distillate.Web",
      "console": "internalConsole",
      "stopAtEntry": false,
      "env": {
        "ASPNETCORE_ENVIRONMENT": "Development",
        "MODE": "live"
      }
    }
  ]
}

