# Everything the service reads is environment configuration. Copy this file to
# `.env` next to the compose file, or pass the variables directly. Every value
# below is the default the code uses, so an empty file is a valid deployment.

# --- Mode -------------------------------------------------------------------
# `rest` exposes the JSON API. `live` serves the interactive web UI instead.
# The two are mutually exclusive: the service runs in one mode only.
MODE=rest

# --- Capacity ---------------------------------------------------------------
# Maximum simultaneous extractions. There is no internal queue: a request that
# arrives at capacity is refused immediately with 503 and a Retry-After.
CONCURRENCY=1
BUSY_RETRY_AFTER_SECONDS=15

# Hard ceiling for one request, milliseconds. Must stay below the container's
# stop grace period or an in-flight request is SIGKILLed on shutdown.
MAX_TIME_MS=180000

# Global budget for images embedded as base64 data URIs, bytes.
MAX_IMAGE_BYTES=209715200

# --- Browser ----------------------------------------------------------------
# `normal` or `aggressive` (force a compacting gen2 GC after every request).
GC_MODE=normal

# How long to wait for the DOM to settle after load, milliseconds.
STABILIZATION_MS=10000

# Delay between scroll steps while lazy-loading images, milliseconds.
SCROLL_DELAY_MS=100

# V8 heap ceiling for the browser, megabytes.
MAX_V8_HEAP_SIZE_MB=512

# Path to the Chromium binary. The image sets this to the browser it ships.
CHROMIUM_PATH=/usr/bin/chromium

# Extra Chromium command-line arguments, space separated. Leave empty unless you
# know why you need them.
# CHROMIUM_ARGS=

# --- HTTP -------------------------------------------------------------------
PORT=8080

# Default User-Agent for page fetches. Empty means the built-in Chrome UA string.
# USER_AGENT=

# Longest URL accepted, characters.
MAX_URL_LENGTH=2048

# --- Logging ----------------------------------------------------------------
# Trace, Debug, Information, Warning, Error, Critical
LOG_LEVEL=Information
